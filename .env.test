# Test Environment - AI Remedial Learning Platform
NODE_ENV=test
APP_ENV=test
API_PORT=3002
APP_VERSION=1.0.0-test
APP_COMMIT=test

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_remedial_test?schema=public
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

REDIS_URL=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=5
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

JWT_SECRET=test_jwt_secret_32_chars_minimum_length
JWT_REFRESH_SECRET=test_refresh_secret_32_chars_minimum
JWT_ACCESS_TOKEN_EXPIRES=1h
JWT_REFRESH_TOKEN_EXPIRES=7d

AI_PROVIDER=mock
AI_API_KEY=mock_key
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=5000
AI_MAX_TOKENS=500
AI_MAX_CONTEXT_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=1000
AI_DAILY_TOKEN_LIMIT=1000000
AI_MAX_SESSION_MESSAGES=10

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-remedial-test
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
BACKUP_S3_BUCKET=ai-remedial-backups-test

CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT=10000
AUTH_RATE_LIMIT_WINDOW=900
GENERAL_RATE_LIMIT=10000
GENERAL_RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT=10000
AI_RATE_LIMIT_WINDOW=60
ASSESSMENT_RATE_LIMIT=10000
ASSESSMENT_RATE_LIMIT_WINDOW=60
UPLOAD_RATE_LIMIT=10000
UPLOAD_RATE_LIMIT_WINDOW=3600

QUEUE_CONCURRENCY=1
WORKER_CONCURRENCY=1
QUEUE_JOB_TIMEOUT_MS=30000
QUEUE_MAX_ATTEMPTS=1
QUEUE_BACKOFF_DELAY_MS=100

CACHE_TTL=10
CACHE_TTL_LONG=30
CACHE_TTL_SHORT=5

MAX_FILE_SIZE=5242880
MAX_REQUEST_SIZE=1048576
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown

SENTRY_DSN=
SENTRY_ENVIRONMENT=test
LOG_LEVEL=error

AI_TUTOR_ENABLED=true
AI_PRACTICE_ENABLED=true
AI_ASSESSMENT_GENERATION_ENABLED=true
RAG_ENABLED=true
ADAPTIVE_ASSESSMENT_ENABLED=true
TEACHER_AI_ENABLED=true
MAINTENANCE_MODE=false

NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_APP_VERSION=1.0.0-test

ADMIN_API_KEY=test_admin_key
