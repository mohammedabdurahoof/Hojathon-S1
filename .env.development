# Development Environment - AI Remedial Learning Platform
NODE_ENV=development
APP_ENV=development
API_PORT=3001
APP_VERSION=1.0.0-dev
APP_COMMIT=local

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_remedial_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

JWT_SECRET=dev_jwt_secret_not_for_production_use_only_dev
JWT_REFRESH_SECRET=dev_refresh_secret_not_for_production_use_only_dev
JWT_ACCESS_TOKEN_EXPIRES=1h
JWT_REFRESH_TOKEN_EXPIRES=30d

AI_PROVIDER=mock
AI_API_KEY=mock_key
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS=2000
AI_MAX_CONTEXT_TOKENS=8000
AI_RATE_LIMIT_PER_MINUTE=100
AI_DAILY_TOKEN_LIMIT=10000000
AI_MAX_SESSION_MESSAGES=100

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-remedial-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
BACKUP_S3_BUCKET=ai-remedial-backups-dev

CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT=100
AUTH_RATE_LIMIT_WINDOW=900
GENERAL_RATE_LIMIT=1000
GENERAL_RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT=100
AI_RATE_LIMIT_WINDOW=60
ASSESSMENT_RATE_LIMIT=1000
ASSESSMENT_RATE_LIMIT_WINDOW=60
UPLOAD_RATE_LIMIT=100
UPLOAD_RATE_LIMIT_WINDOW=3600

QUEUE_CONCURRENCY=2
WORKER_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=60000
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000

CACHE_TTL=60
CACHE_TTL_LONG=300
CACHE_TTL_SHORT=30

MAX_FILE_SIZE=52428800
MAX_REQUEST_SIZE=10485760
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
LOG_LEVEL=debug

AI_TUTOR_ENABLED=true
AI_PRACTICE_ENABLED=true
AI_ASSESSMENT_GENERATION_ENABLED=true
RAG_ENABLED=true
ADAPTIVE_ASSESSMENT_ENABLED=true
TEACHER_AI_ENABLED=true
MAINTENANCE_MODE=false

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_VERSION=1.0.0-dev

ADMIN_API_KEY=dev_admin_key_not_for_production
