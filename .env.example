# ============================================================
# AI REMEDIAL LEARNING PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env.development, .env.test, or .env.production
# NEVER commit real secrets. Use a secrets manager in production.

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
API_PORT=3001
APP_VERSION=1.0.0
APP_COMMIT=local

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_remedial_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# ─────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────
# CRITICAL: Use a strong random secret in production (min 64 chars)
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_STRONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d

# ─────────────────────────────────────────────
# AI PROVIDER
# ─────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS=2000
AI_MAX_CONTEXT_TOKENS=8000

# ─────────────────────────────────────────────
# AI COST CONTROLS
# ─────────────────────────────────────────────
AI_RATE_LIMIT_PER_MINUTE=20
AI_DAILY_TOKEN_LIMIT=1000000
AI_MAX_SESSION_MESSAGES=50

# ─────────────────────────────────────────────
# S3-COMPATIBLE OBJECT STORAGE
# ─────────────────────────────────────────────
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=ai-remedial-documents
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_REGION=nyc3

# Backup storage
BACKUP_S3_BUCKET=ai-remedial-backups

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# Production: exact origins only (no wildcards)
CORS_ORIGINS=http://localhost:3000
# Production example: CORS_ORIGINS=https://app.example.com

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Login: 10 attempts per 15 minutes per IP
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=900
# General API: 100 requests per minute per user
GENERAL_RATE_LIMIT=100
GENERAL_RATE_LIMIT_WINDOW=60
# AI tutor: 20 requests per minute per user
AI_RATE_LIMIT=20
AI_RATE_LIMIT_WINDOW=60
# Assessment answers: 60 per minute per user
ASSESSMENT_RATE_LIMIT=60
ASSESSMENT_RATE_LIMIT_WINDOW=60
# File upload: 10 per hour per user
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_LIMIT_WINDOW=3600

# ─────────────────────────────────────────────
# QUEUE / WORKERS
# ─────────────────────────────────────────────
QUEUE_CONCURRENCY=5
WORKER_CONCURRENCY=3
QUEUE_JOB_TIMEOUT_MS=120000
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=5000

# ─────────────────────────────────────────────
# CACHING
# ─────────────────────────────────────────────
CACHE_TTL=300
CACHE_TTL_LONG=3600
CACHE_TTL_SHORT=60

# ─────────────────────────────────────────────
# FILE UPLOAD
# ─────────────────────────────────────────────
MAX_FILE_SIZE=52428800
MAX_REQUEST_SIZE=10485760
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─────────────────────────────────────────────
# OBSERVABILITY / MONITORING
# ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
AI_TUTOR_ENABLED=true
AI_PRACTICE_ENABLED=true
AI_ASSESSMENT_GENERATION_ENABLED=true
RAG_ENABLED=true
ADAPTIVE_ASSESSMENT_ENABLED=true
TEACHER_AI_ENABLED=true
MAINTENANCE_MODE=false

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_SENTRY_DSN=  (only safe, non-secret Sentry DSN for frontend)

# ─────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
